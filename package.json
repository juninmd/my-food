{
  "name": "webdiet",
  "version": "1.0.0",
  "description": "Meal Planning and Health Application",
  "type": "module",
  "keywords": [
    "flutter",
    "diet",
    "health",
    "meal-planner"
  ],
  "scripts": {
    "start": "tsx server.ts",
    "build:server": "tsc",
    "release": "NODE_OPTIONS='--import tsx' semantic-release -e ./release.config.ts"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@types/express": "^5.0.6",
    "@types/node": "26.6.6",
    "@types/semantic-release": "^21.1.0",
    "@types/signale": "^1.4.7",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "pnpm": {
    "approvedBuilds": [
      "esbuild"
    ],
    "overrides": {
      "handlebars": ">=4.7.10",
      "micromatch": "npm:picomatch@^2.3.1",
      "body-parser": ">=2.4.0, 1.20.9 <3.0.0",
      "path-to-regexp": ">=8.4.0 <9.0.0",
      "proxy-addr": ">=2.0.8 <3.0.0"
    }
  },
  "packageManager": "pnpm@10.30.3"
}
